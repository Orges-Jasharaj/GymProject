{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/Auth/{**catch-all}"
        }
      },
      "users-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/User/{**catch-all}"
        }
      },
      "userprofiles-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/UserProfiles/{**catch-all}"
        }
      },
      "fitness-route": {
        "ClusterId": "fitness-cluster",
        "Match": {
          "Path": "/api/FitnessPlan/{**catch-all}"
        }
      },
      "exercises-route": {
        "ClusterId": "fitness-cluster",
        "Match": {
          "Path": "/api/Exercises/{**catch-all}"
        }
      },
      "planexercises-route": {
        "ClusterId": "fitness-cluster",
        "Match": {
          "Path": "/api/PlanExercises/{**catch-all}"
        }
      },
      "meal-route": {
        "ClusterId": "nutrition-cluster",
        "Match": {
          "Path": "/api/Meal/{**catch-all}"
        }
      },
      "subscription-route": {
        "ClusterId": "subscription-cluster",
        "Match": {
          "Path": "/api/UserSubscription/{**catch-all}"
        }
      },
      "subscription-plan-route": {
        "ClusterId": "subscription-cluster",
        "Match": {
          "Path": "/api/SubscriptionPlan/{**catch-all}"
        }
      },
      "gym-route": {
        "ClusterId": "subscription-cluster",
        "Match": {
          "Path": "/api/Gym/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7092"
          }
        }
      },
      "fitness-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7190"
          }
        }
      },
      "nutrition-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7030"
          }
        }
      },
      "subscription-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7216"
          }
        }
      }
    }
  }
}
